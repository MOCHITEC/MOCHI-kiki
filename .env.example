# Bot Framework
MICROSOFT_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_APP_PASSWORD=your-bot-password

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=meeting_db

# Microsoft Graph API
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=your-graph-secret

# Graph 変更通知の受信先 URL
GRAPH_NOTIFICATION_URL=https://your-bot-url.azurecontainerapps.io/api/notifications

# App
PORT=3978

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX=documents

# ─────────────────────────────────────────────────────────────────
# Recall.ai (生音声 + transcript 取得)
# ─────────────────────────────────────────────────────────────────

# 発話ソース切替: graph (Teams Live Transcription) / recall / both
# Recall 経路を使う場合は recall または both
TRANSCRIPT_SOURCE=graph

# Recall.ai dashboard → API Keys で発行する API key
RECALL_API_KEY=

# Recall.ai dashboard → API Keys → Verification secret (Svix 互換 whsec_... 形式)
# webhook / websocket 共通の HMAC-SHA256 検証用
RECALL_WEBHOOK_SECRET=

# Recall.ai のリージョン (us-east-1 / us-west-2 / eu-central-1 / ap-northeast-1)
RECALL_REGION=us-east-1

# ─── Transport: webhook (HTTPS POST) と websocket (生音声 PCM) の切替 ──
# webhook  : 既存方式。確定 transcript のみ POST で受信
# websocket: 生音声 + transcript を WebSocket で受信 (推奨)
# both     : 移行期に両方有効化
RECALL_TRANSPORT=webhook

# webhook 経路の公開 URL。RECALL_TRANSPORT=webhook/both で必須
RECALL_WEBHOOK_PUBLIC_URL=https://your-bot-url.azurecontainerapps.io/api/recall/webhook

# WebSocket 経路の公開 URL。RECALL_TRANSPORT=websocket/both で必須
# 必ず wss:// (TLS)。terraform output recall_ws_url で取得できる
RECALL_WS_PUBLIC_URL=wss://your-bot-url.azurecontainerapps.io/api/recall/ws

# 生音声の後段プラグイン
# noop          何もしない (既定)
# file          /tmp/mochi-kiki-audio/<meeting_id>.pcm に追記 (dev/debug 用)
# azure_speech  Azure AI Speech 接続 (未実装、別 spec 予定)
RECALL_AUDIO_SINK=noop

# 以下の値はコード内ハードコード:
#   bot 表示名         = "MOCHI-kiki"
#   transcript 言語    = "ja"
#   WS 購読イベント    = audio_mixed_raw.data, transcript.data
#   WS 単一フレーム上限 = 1 MiB
