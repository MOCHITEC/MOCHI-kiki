# Bot Framework
MICROSOFT_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_APP_PASSWORD=your-bot-password

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=meeting_db

# Microsoft Graph API
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=your-graph-secret
GRAPH_NOTIFICATION_URL=https://your-bot-url.azurecontainerapps.io/api/notifications

# App
PORT=3978

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX=documents

# Recall.ai  (RECALL_API_KEY / RECALL_WEBHOOK_SECRET は dashboard → API Keys)
TRANSCRIPT_SOURCE=recall                  # graph | recall | both
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=                    # whsec_...
RECALL_REGION=ap-northeast-1
RECALL_TRANSPORT=websocket                # webhook | websocket | both
RECALL_WS_PUBLIC_URL=wss://your-bot-url.azurecontainerapps.io/api/recall/ws
RECALL_WEBHOOK_PUBLIC_URL=https://your-bot-url.azurecontainerapps.io/api/recall/webhook
RECALL_AUDIO_SINK=noop                    # noop | file | azure_speech

# MOCHI-kiki 管理コンソール (frontend-bot-console)
# - CONSOLE_ENABLED=true で /api/console/* 有効化
# - CONSOLE_PASSWORD_HASH は bcrypt cost=12 ハッシュ:
#     python -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt(12)).decode())"
# - CONSOLE_JWT_SECRET は 64bytes ランダム: openssl rand -hex 64
# - CONSOLE_COOKIE_SECURE=false にすると HTTP (localhost) でも Cookie が動く
#
# 下記は dev 用サンプル (username=admin / password=admin)。
# 本番デプロイ前に *必ず* 差し替えること。Secret は Key Vault → env 注入を推奨。
CONSOLE_ENABLED=true
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD_HASH=$2b$12$m3YuxC8IpJ/yq.2r9607MOylj7BQ0yj2oINRAtNltUqpCpTT5KJ9W
CONSOLE_JWT_SECRET=41994ca0bb58c0335d4a6bba6a2bbaf9a7a92ee5fb737f07d45d70710083a8efd1da5d71dfcddb4a41e7210bcfa2c5b31bcf3a6b484ec6043e197a68496b8f1b
CONSOLE_COOKIE_SECURE=false

